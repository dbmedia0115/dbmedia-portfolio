{
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/", "destination": "/api/blog" },
    { "source": "/blog/rss.xml", "destination": "/api/blog?feed=rss" },
    { "source": "/blog-sitemap.xml", "destination": "/api/blog?feed=sitemap" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" }
  ]
}
